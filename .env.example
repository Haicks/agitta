# Configuração PÚBLICA do frontend. Copie para .env.local.
# Use somente URL e chave anon/publishable do seu projeto Supabase.
# Nunca use service_role, sb_secret_ ou senha do banco neste aplicativo.
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-publica-anon-ou-publishable
