{
  "name": "agitta",
  "version": "0.2.0",
  "private": true,
  "description": "O próximo rolê de Brasília, na sua mão.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "backend:start": "node scripts/start-local-backend.mjs",
    "backend:configure": "node scripts/configure-local.mjs",
    "backend:stop": "docker compose --env-file .tools/supabase-local/.env -f supabase/local/compose.yml stop",
    "test:live": "node scripts/test-live.mjs",
    "test:live:browser": "node scripts/test-live-browser.mjs",
    "build:public": "node scripts/build-public.mjs",
    "icons": "node scripts/create-icons.mjs",
    "test:web": "playwright test --config playwright.web.config.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "vite": "8.3.5"
  }
}
